+/* Win32_PnPDevice: associates each Win32_DiskDrive with the Win32_PnPEntity of the same
+ * PNPDeviceID. VRC Pro walks LogicalDisk -> Partition -> DiskDrive -> PnPDevice to build
+ * its hardware ID and aborts login when this class is empty. */
+static enum fill_status fill_pnpdevice( struct table *table, const struct expr *cond )
+{
+    struct record_pnpdevice *rec;
+    struct query *query;
+    UINT i, row = 0, offset = 0;
+    enum fill_status status = FILL_STATUS_UNFILTERED;
+    VARIANT path, pnpid;
+    const WCHAR *colon;
+    WCHAR *system;
+    size_t len;
+
+    if (!(query = create_query( WBEMPROX_NAMESPACE_CIMV2 ))) return FILL_STATUS_FAILED;
+    if (parse_query( WBEMPROX_NAMESPACE_CIMV2, L"SELECT * FROM Win32_DiskDrive", &query->view, &query->mem ) != S_OK ||
+        execute_view( query->view ) != S_OK)
+    {
+        free_query( query );
+        return FILL_STATUS_FAILED;
+    }
+    if (!resize_table( table, query->view->result_count, sizeof(*rec) ))
+    {
+        free_query( query );
+        return FILL_STATUS_FAILED;
+    }
+
+    for (i = 0; i < query->view->result_count; i++)
+    {
+        VariantInit( &path );
+        VariantInit( &pnpid );
+        if (get_propval( query->view, i, L"__PATH", &path, NULL, NULL ) != S_OK ||
+            get_propval( query->view, i, L"PNPDeviceID", &pnpid, NULL, NULL ) != S_OK ||
+            V_VT(&path) != VT_BSTR || V_VT(&pnpid) != VT_BSTR ||
+            !(colon = wcschr( V_BSTR(&path), ':' )))
+        {
+            VariantClear( &path );
+            VariantClear( &pnpid );
+            continue;
+        }
+
+        /* "\\HOST\ROOT\CIMV2:" + "Win32_PnPEntity.DeviceID=\"" + id + "\"", with backslashes
+         * in the id escaped like __PATH does for key values */
+        len = (colon - V_BSTR(&path) + 1) + wcslen( L"Win32_PnPEntity.DeviceID=\"\"" ) + 2 * wcslen( V_BSTR(&pnpid) ) + 1;
+        if (!(system = malloc( len * sizeof(WCHAR) )))
+        {
+            VariantClear( &path );
+            VariantClear( &pnpid );
+            break;
+        }
+        {
+            const WCHAR *s;
+            WCHAR *d;
+            int n = swprintf( system, len, L"%.*sWin32_PnPEntity.DeviceID=\"",
+                              (int)(colon - V_BSTR(&path) + 1), V_BSTR(&path) );
+            d = system + n;
+            for (s = V_BSTR(&pnpid); *s; s++)
+            {
+                if (*s == '\\') *d++ = '\\';
+                *d++ = *s;
+            }
+            *d++ = '\"';
+            *d = 0;
+        }
+
+        rec = (struct record_pnpdevice *)(table->data + offset);
+        rec->sameelement   = wcsdup( V_BSTR(&path) );
+        rec->systemelement = system;
+        VariantClear( &path );
+        VariantClear( &pnpid );
+
+        if (!match_row( table, row, cond, &status ))
+        {
+            free_row_values( table, row );
+            continue;
+        }
+        offset += sizeof(*rec);
+        row++;
+    }
+    free_query( query );
+
+    TRACE("created %u rows\n", row);
+    table->num_rows = row;
+    return status;
+}
